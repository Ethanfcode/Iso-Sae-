ds"}, {"label": "Furlong/Fortnight", "value": "fpf"}], "parent": "", "type": "string", "value": "regional"}, {"addontype": "xbmc.ui.screensaver", "allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "", "enabled": true, "help": "S\u00e9lection de l'\u00e9conomiseur d'\u00e9cran. L'\u00e9conomiseur d'\u00e9cran \u00ab Dim \u00bb sera impos\u00e9 quand une lecture plein \u00e9cran sera mise en pause ou qu'une fen\u00eatre de dialogue sera active.", "id": "screensaver.mode", "label": "Mode \u00e9conomiseur d'\u00e9cran", "level": "basic", "parent": "", "type": "addon", "value": ""}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": false, "help": "S\u00e9lection des param\u00e8tres sp\u00e9cifiques \u00e0 l'\u00e9conomiseur d'\u00e9cran. Chacune des options disponibles \u00e0 la configuration d\u00e9pend des fonctionnalit\u00e9s fournies par l'extension \u00e9conomiseur d'\u00e9cran.", "id": "screensaver.settings", "label": "Param\u00e8tres", "level": "standard", "parent": "screensaver.mode", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": false, "help": "Pr\u00e9visualise l'\u00e9conomiseur d'\u00e9cran s\u00e9lectionn\u00e9.", "id": "screensaver.preview", "label": "Pr\u00e9visualisation", "level": "standard", "parent": "screensaver.mode", "type": "action"}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} min", "type": "spinner"}, "default": 3, "enabled": false, "help": "D\u00e9finit le temps d'inactivit\u00e9 pour d\u00e9clencher l'\u00e9conomiseur d'\u00e9cran.", "id": "screensaver.time", "label": "Temporisation", "level": "basic", "maximum": 60, "minimum": 1, "parent": "", "step": 1, "type": "integer", "value": 3}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "Pendant la lecture de musique, la visualisation choisie sera lanc\u00e9e au lieu d'afficher l'\u00e9conomiseur d'\u00e9cran.", "id": "screensaver.usemusicvisinstead", "label": "Activer la visualisation en lecture audio", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "Diminue l'intensit\u00e9 de l'affichage quand le m\u00e9dia est en pause. Non valable pour l'\u00e9conomiseur d'\u00e9cran \u00ab Dim \u00bb.", "id": "screensaver.usedimonpause", "label": "Att\u00e9nuer quand le lecteur vid\u00e9o est en pause", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Il est possible ici d'activer ou d\u00e9sactiver le verrouillage ma\u00eetre et de d\u00e9finir le code PIN pour le d\u00e9verrouiller, ainsi que de sp\u00e9cifier les sections de l'application qui n\u00e9cessiteront le code PIN pour y acc\u00e9der.", "id": "masterlock.lockcode", "label": "Code et param\u00e8tres de verrouillage ma\u00eetre", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": false, "help": "Si activ\u00e9, le code du verrouillage ma\u00eetre est n\u00e9cessaire pour d\u00e9verrouiller cette application au d\u00e9marrage.", "id": "masterlock.startuplock", "label": "Demander le code de verrouillage ma\u00eetre au d\u00e9marrage", "level": "standard", "parent": "masterlock.lockcode", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "S\u00e9lection d'une action \u00e0 effectuer au d\u00e9marrage de Kodi.", "id": "lookandfeel.startupaction", "label": "Action au d\u00e9marrage", "level": "basic", "options": [{"label": "Aucun(e)", "value": 0}, {"label": "Voir la TV", "value": 1}, {"label": "\u00c9couter la radio", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 10000, "enabled": true, "help": "S\u00e9lection de la fen\u00eatre de m\u00e9dia \u00e0 afficher au d\u00e9marrage.", "id": "lookandfeel.startupwindow", "label": "Fen\u00eatre de d\u00e9marrage", "level": "basic", "options": [{"label": "Fen\u00eatre d'accueil", "value": 10000}, {"label": "Cha\u00eenes TV", "value": 10700}, {"label": "Guide TV", "value": 10702}, {"label": "Cha\u00eenes radio", "value": 10705}, {"label": "Guide des radios", "value": 10707}, {"label": "Programmes", "value": 10001}, {"label": "Images", "value": 10002}, {"label": "Musique", "value": 10502}, {"label": "Vid\u00e9os", "value": 10025}, {"label": "Gestion des fichiers", "value": 10003}, {"label": "Param\u00e8tres", "value": 10004}, {"label": "M\u00e9t\u00e9o", "value": 12600}, {"label": "Favoris", "value": 10060}], "parent": "", "type": "integer", "value": 10000}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Ceci fournit l'acc\u00e8s aux emplacements o\u00f9 les sources de vid\u00e9os peuvent \u00eatre ajout\u00e9es et g\u00e9r\u00e9es.", "id": "source.videos", "label": "Vid\u00e9os\u2026", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Ceci fournit l'acc\u00e8s aux emplacements o\u00f9 les sources de musique peuvent \u00eatre ajout\u00e9es et g\u00e9r\u00e9es.", "id": "source.music", "label": "Musique\u2026", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Ceci fournit l'acc\u00e8s aux emplacements o\u00f9 les sources d'images peuvent \u00eatre ajout\u00e9es et g\u00e9r\u00e9es.", "id": "source.pictures", "label": "Images\u2026", "level": "standard", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Recherche les nouveaux fichiers multim\u00e9dia au d\u00e9marrage.", "id": "videolibrary.updateonstartup", "label": "Actualiser la m\u00e9diath\u00e8que au d\u00e9marrage", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Masque la barre de progression lors des analyses de m\u00e9diath\u00e8que.", "id": "videolibrary.backgroundupdate", "label": "Masquer la progression des mises \u00e0 jour de la m\u00e9diath\u00e8que", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Retire les \u00e9l\u00e9ments de la m\u00e9diath\u00e8que qui n'ont pas pu \u00eatre trouv\u00e9s (car renomm\u00e9s, supprim\u00e9s, ou sur un stockage amovible actuellement d\u00e9connect\u00e9).", "id": "videolibrary.cleanup", "label": "Nettoyer la m\u00e9diath\u00e8que", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Permet d'exporter la base de donn\u00e9es de la vid\u00e9oth\u00e8que au format XML. Cela peut potentiellement \u00e9craser les fichiers XML d\u00e9j\u00e0 pr\u00e9sents.", "id": "videolibrary.export", "label": "Exporter la m\u00e9diath\u00e8que", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Importe un fichier XML dans la base de donn\u00e9es de la vid\u00e9oth\u00e8que.", "id": "videolibrary.import", "label": "Importer une m\u00e9diath\u00e8que", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Recherche au d\u00e9marrage les fichiers m\u00e9dia ajout\u00e9s ou retir\u00e9s.", "id": "musiclibrary.updateonstartup", "label": "Actualiser la m\u00e9diath\u00e8que au d\u00e9marrage", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Masque la barre de progression lors des analyses de m\u00e9diath\u00e8que.", "id": "musiclibrary.backgroundupdate", "label": "Masquer la progression des mises \u00e0 jour de la m\u00e9diath\u00e8que", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Retire les \u00e9l\u00e9ments de la m\u00e9diath\u00e8que qui n'ont pas pu \u00eatre trouv\u00e9s (car renomm\u00e9s, supprim\u00e9s, ou sur un stockage amovible actuellement d\u00e9connect\u00e9).", "id": "musiclibrary.cleanup", "label": "Nettoyer la m\u00e9diath\u00e8que", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Exporte des parties de la musicoth\u00e8que vers des fichiers XML ou NFO. Cela \u00e9crasera optionnellement les fichiers NFO et d'illustration existants.", "id": "musiclibrary.export", "label": "Exporter la m\u00e9diath\u00e8que", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Importe un fichier XML dans la base de donn\u00e9es de la musicoth\u00e8que.", "id": "musiclibrary.import", "label": "Importer une m\u00e9diath\u00e8que", "level": "advanced", "parent": "", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Ajoute l'\u00e9l\u00e9ment (..) dans les listes pour acc\u00e9der au dossier parent.", "id": "filelists.showparentdiritems", "label": "Afficher les \u00e9l\u00e9ments du dossier parent", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Ignore certains d\u00e9terminants, comme \u00ab Les \u00bb, lors des op\u00e9rations de tri. Par exemple, \u00ab Les Simpsons \u00bb sera class\u00e9 en tant que \u00ab Simpsons \u00bb.", "id": "filelists.ignorethewhensorting", "label": "Ignorer les articles lors du tri", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Affiche l'extension des fichiers m\u00e9dia, par ex. \u00ab You Enjoy Myself \u00bb sera affich\u00e9 comme \u00ab You Enjoy Myself.mp3 \u00bb.", "id": "filelists.showextensions", "label": "Afficher les extensions de fichiers", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Affiche le bouton pour ajouter une source dans chaque section \u00e0 la racine de l'interface utilisateur.", "id": "filelists.showaddsourcebuttons", "label": "Afficher les boutons \u00ab Ajouter une source \u00bb", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Affiche les dossiers et les fichiers cach\u00e9s lors de l'affichage des fichiers.", "id": "filelists.showhidden", "label": "Afficher les dossiers et les fichiers cach\u00e9s", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Autorise le renommage et la suppression de fichiers depuis le menu contextuel de l'interface. Avec un clavier, la touche \u00ab C \u00bb permet d'afficher ce menu.", "id": "filelists.allowfiledeletion", "label": "Autoriser \u00e0 renommer et supprimer des fichiers", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "Commute entre [Choisir], [Lire] (par d\u00e9faut), [Reprendre] et [Afficher les informations].[CR][Choisir] va proposer des choix, par ex. ouvrir un dossier en mode fichiers.[CR][Reprendre] va reprendre les vid\u00e9os au dernier point d'arr\u00eat, m\u00eame apr\u00e8s un red\u00e9marrage du syst\u00e8me.", "id": "myvideos.selectaction", "label": "Action de s\u00e9lection pr\u00e9d\u00e9finie", "level": "basic", "options": [{"label": "Choisir", "value": 0}, {"label": "Lire", "value": 1}, {"label": "Reprendre", "value": 2}, {"label": "Afficher les informations", "value": 3}, {"label": "Placer en file d'attente", "value": 7}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Activer pour utiliser les tags int\u00e9gr\u00e9s aux fichiers mp4 ou mkv comme m\u00e9tadonn\u00e9es de la biblioth\u00e8que. Cela emp\u00eachera le bon fonctionnement des scrapers.", "id": "myvideos.usetags", "label": "Utiliser les balises vid\u00e9o", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Extrait les informations des m\u00e9tadonn\u00e9es comme le codec et le ratio d'aspect des vid\u00e9os.", "id": "myvideos.extractflags", "label": "Extraire les informations vid\u00e9o des fichiers", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Extrait les miniatures de chapitre pour pr\u00e9sentation dans la fen\u00eatre de dialogue de chapitrage/signets. Ceci est susceptible d'augmenter la charge du processeur.", "id": "myvideos.extractchapterthumbs", "label": "Extraire les miniatures de chapitre", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Combine les vid\u00e9os multiparties, les dossiers de DVD ou les dossiers de films en un seul \u00e9l\u00e9ment dans les affichages n'appartenant pas \u00e0 une m\u00e9diath\u00e8que.", "id": "myvideos.stackvideos", "label": "Combiner les \u00e9l\u00e9ments vid\u00e9o s\u00e9par\u00e9s", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Quand un fichier est analys\u00e9 dans la m\u00e9diath\u00e8que, le titre figurant dans les m\u00e9tadonn\u00e9es sera affich\u00e9 \u00e0 la place du nom de fichier.", "id": "myvideos.replacelabels", "label": "Remplacer les noms de fichiers par les titres en m\u00e9diath\u00e8que", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Affiche l'entr\u00e9e \u00ab Tous les \u00e9l\u00e9ments \u00bb dans le dossier, par ex. \u00ab Tous les albums \u00bb ou \u00ab Toutes les saisons \u00bb.", "id": "videolibrary.showallitems", "label": "Afficher l'entr\u00e9e \u00ab Tous les \u00e9l\u00e9ments \u00bb", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [0, 1, 2], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": 0, "enabled": true, "help": "Affiche les informations pour les m\u00e9dias non regard\u00e9s de la vid\u00e9oth\u00e8que, ou les masque si non s\u00e9lectionn\u00e9s pour ne pas g\u00e2cher le suspens. Options disponibles : \u00ab Intrigue du film \u00bb, \u00ab Intrigue de l'\u00e9pisode \u00bb et \u00ab Miniature de l'\u00e9pisode \u00bb.", "id": "videolibrary.showunwatchedplots.definition", "label": "Afficher les infos des \u00e9l\u00e9ments non vus", "level": "basic", "options": [{"label": "Intrigue du film", "value": 0}, {"label": "Intrigue de l'\u00e9pisode", "value": 1}, {"label": "Miniature de l'\u00e9pisode", "value": 2}], "parent": "", "type": "integer", "value": 0}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "Affiche les informations pour les m\u00e9dias non regard\u00e9s de la vid\u00e9oth\u00e8que, ou les masque si non s\u00e9lectionn\u00e9s pour ne pas g\u00e2cher le suspens. Options disponibles : \u00ab Intrigue du film \u00bb, \u00ab Intrigue de l'\u00e9pisode \u00bb et \u00ab Miniature de l'\u00e9pisode \u00bb.", "id": "videolibrary.showunwatchedplots", "label": "Afficher les infos des \u00e9l\u00e9ments non vus", "level": "basic", "maximumItems": -1, "minimumItems": 0, "parent": "", "type": "list", "value": [0, 1, 2]}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Si activ\u00e9, les films qui appartiennent \u00e0 une \u00ab Saga \u00bb sont regroup\u00e9s sous une seule entr\u00e9e pour cette saga dans la vid\u00e9oth\u00e8que. Cette entr\u00e9e peut \u00eatre ensuite ouverte pour afficher tous ses films. Si d\u00e9sactiv\u00e9, chaque film aura sa propre entr\u00e9e dans la vid\u00e9oth\u00e8que m\u00eame si appartenant \u00e0 une saga.", "id": "videolibrary.groupmoviesets", "label": "Afficher les sagas", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Si activ\u00e9, une entr\u00e9e \u00ab Saga \u00bb est utilis\u00e9e m\u00eame si la vid\u00e9oth\u00e8que ne contient qu'un seul film de cette saga. Si d\u00e9sactiv\u00e9, une entr\u00e9e \u00ab Saga \u00bb n'est utilis\u00e9e que si la vid\u00e9oth\u00e8que contient plus d'un film de cette saga.", "id": "videolibrary.groupsingleitemsets", "label": "Inclure les sagas ne comportant qu'un seul film", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Retire le titre, le genre, etc. de la vue M\u00e9diath\u00e8que. La s\u00e9lection d'une cat\u00e9gorie emm\u00e8ne directement \u00e0 la vue Titre.", "id": "myvideos.flatten", "label": "R\u00e9duire l'arborescence", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "Permet de choisir dans quels cas les saisons des s\u00e9ries TV doivent \u00eatre affich\u00e9es. Si masqu\u00e9es, la s\u00e9lection d'une s\u00e9rie TV affichera directement la vue des \u00e9pisodes.", "id": "videolibrary.flattentvshows", "label": "R\u00e9duire l'arborescence des saisons de s\u00e9ries TV", "level": "advanced", "options": [{"label": "Jamais", "value": 0}, {"label": "Si une saison seule", "value": 1}, {"label": "Toujours", "value": 2}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Affiche les s\u00e9ries TV sans \u00e9pisode lors du parcours de la vid\u00e9oth\u00e8que.", "id": "videolibrary.showemptytvshows", "label": "Afficher les s\u00e9ries TV vides", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "En acc\u00e9dant \u00e0 une vue saison ou \u00e9pisode de s\u00e9rie TV, s\u00e9lectionne automatiquement la premi\u00e8re saison ou \u00e9pisode non vu.[CR][Au premier acc\u00e8s] S\u00e9lectionne le premier \u00e9l\u00e9ment non vu lors du premier acc\u00e8s \u00e0 la vue.[CR][Toujours] S\u00e9lectionne le premier \u00e9l\u00e9ment non vu \u00e0 chaque acc\u00e8s \u00e0 la vue.", "id": "videolibrary.tvshowsselectfirstunwatcheditem", "label": "S\u00e9lectionner 1er \u00e9pisode/saison non vu d'une s\u00e9rie TV", "level": "advanced", "options": [{"label": "Jamais", "value": 0}, {"label": "Au premier acc\u00e8s", "value": 1}, {"label": "Toujours", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": false, "help": "Prend ou non en compte les \u00e9l\u00e9ments de \u00ab Toutes les saisons \u00bb et \u00ab \u00c9pisodes sp\u00e9ciaux \u00bb dans la s\u00e9lection des \u00e9l\u00e9ments non regard\u00e9s.", "id": "videolibrary.tvshowsincludeallseasonsandspecials", "label": "Inclure \u00ab Toutes les saisons \u00bb et \u00ab \u00c9pisodes sp\u00e9ciaux \u00bb", "level": "advanced", "options": [{"label": "Aucun des deux", "value": 0}, {"label": "Les deux", "value": 1}, {"label": "\u00ab Toutes les saisons \u00bb uniquement", "value": 2}, {"label": "\u00ab \u00c9pisodes sp\u00e9ciaux \u00bb uniquement", "value": 3}], "parent": "videolibrary.tvshowsselectfirstunwatcheditem", "type": "integer", "value": 0}, {"allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "path", "heading": "Rechercher un dossier", "type": "button"}, "default": "", "enabled": true, "help": "S\u00e9lectionne le dossier o\u00f9 les informations du film (images) sont enregistr\u00e9es localement.", "id": "videolibrary.moviesetsfolder", "label": "Dossier d'informations des sagas", "level": "standard", "parent": "", "sources": ["files", "pictures", "videos"], "type": "path", "value": "", "writable": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Si activ\u00e9, affiche tous les interpr\u00e8tes dans la listes des artistes pour les vid\u00e9os musicales, et pas seulement l'interpr\u00e8te principal", "id": "videolibrary.musicvideosallperformers", "label": "Afficher tous les interpr\u00e8tes pour les vid\u00e9os musicales", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "La quantit\u00e9 d'illustrations automatiquement s\u00e9lectionn\u00e9e :[CR][Maximale] Toutes les image locales et illustrations distantes[CR][Basique] Espace restreint sur les appareils limit\u00e9s ou en utilisant un habillage simple[CR][Personnalis\u00e9e] Configuration de l'utilisateur pour un contr\u00f4le en d\u00e9tail[CR][Aucune] Pas d'illustration", "id": "videolibrary.artworklevel", "label": "Niveau d'illustration", "level": "standard", "options": [{"label": "Maximal", "value": 0}, {"label": "Base", "value": 1}, {"label": "Personnalisation", "value": 2}, {"label": "Aucun(e)", "value": 3}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "R\u00e9cup\u00e8re les miniatures des acteurs lors de l'ajout de m\u00e9dias \u00e0 la m\u00e9diath\u00e8que.", "id": "videolibrary.actorthumbs", "label": "T\u00e9l\u00e9charger les miniatures des acteurs", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Extrait des miniatures pour les afficher en mode biblioth\u00e8que.", "id": "myvideos.extractthumb", "label": "Extraire les miniatures des fichiers vid\u00e9o", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Affiche l'entr\u00e9e \u00ab Tous les \u00e9l\u00e9ments \u00bb dans le dossier, par ex. \u00ab Tous les albums \u00bb ou \u00ab Toutes les saisons \u00bb.", "id": "musiclibrary.showallitems", "label": "Afficher l'entr\u00e9e \u00ab Tous les \u00e9l\u00e9ments \u00bb", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Si activ\u00e9, les artistes de l'album et ceux du titre sont tous affich\u00e9s. Si d\u00e9sactiv\u00e9, seuls les artistes de l'album sont affich\u00e9s, et les artistes qui apparaissent seulement sur des titres individuels d'un album sont exclus.", "id": "musiclibrary.showcompilationartists", "label": "Afficher les artistes de l'album et de la chanson", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Si activ\u00e9, l'ouverture d'un album multidisques affichera les disques en \u00e9l\u00e9ments individuels plut\u00f4t que toutes les chansons. Ouvrir un disque affichera ensuite les chansons de ce disque.", "id": "musiclibrary.showdiscs", "label": "S\u00e9parer les albums en disques individuels", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Pour trier les \u00e9l\u00e9ments musicaux par artiste, le nom d'artiste sera utilis\u00e9, par ex. Parton, Dolly, plut\u00f4t que le pr\u00e9nom.", "id": "musiclibrary.useartistsortname", "label": "Utiliser le nom d'artiste pour trier par artiste", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Si activ\u00e9, l'ann\u00e9e d'origine de la sortie sera utilis\u00e9e plut\u00f4t que celle de sortie de l'album (si disponible).", "id": "musiclibrary.useoriginaldate", "label": "Utiliser l'ann\u00e9e d'origine pour les sorties d'albums", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "R\u00e9cup\u00e8re automatiquement les informations d'album et d'artiste depuis les fournisseurs d'informations lorsque des titres sont ajout\u00e9s \u00e0 la m\u00e9diath\u00e8que.", "id": "musiclibrary.downloadinfo", "label": "R\u00e9cup\u00e9rer des informations suppl\u00e9mentaires pendant les mises \u00e0 jour", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "path", "heading": "Rechercher un dossier", "type": "button"}, "default": "", "enabled": true, "help": "S\u00e9lectionne le dossier o\u00f9 les informations d'artistes (fichiers NFO et image) devraient \u00eatre enregistr\u00e9es.", "id": "musiclibrary.artistsfolder", "label": "Dossier d'informations de l'artiste", "level": "standard", "parent": "", "sources": [], "type": "path", "value": "", "writable": true}, {"addontype": "xbmc.metadata.scraper.albums", "allowempty": false, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "metadata.generic.albums", "enabled": true, "help": "S\u00e9lectionne le fournisseur pr\u00e9d\u00e9fini d'informations d'album.", "id": "musiclibrary.albumsscraper", "label": "Fournisseur pr\u00e9d\u00e9fini pour les informations d'album", "level": "standard", "parent": "", "type": "addon", "value": "metadata.album.universal"}, {"addontype": "xbmc.metadata.scraper.artists", "allowempty": false, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "metadata.generic.artists", "enabled": true, "help": "S\u00e9lectionne le fournisseur pr\u00e9d\u00e9fini d'informations d'artiste.", "id": "musiclibrary.artistsscraper", "label": "Fournisseur pr\u00e9d\u00e9fini pour les informations d'artiste", "level": "standard", "parent": "", "type": "addon", "value": "metadata.artists.universal"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Avec cette option activ\u00e9e, toutes les informations t\u00e9l\u00e9charg\u00e9es pour les albums et les artistes vont remplacer les informations trouv\u00e9es dans les balises des titres, tel que les genres, l'ann\u00e9e, les artistes, etc. Utile avec les identifiants MusicBrainz dans les balises des titres.", "id": "musiclibrary.overridetags", "label": "Pr\u00e9f\u00e9rer les informations en ligne", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "La quantit\u00e9 d'illustrations automatiquement s\u00e9lectionn\u00e9e :[CR][Maximale] Toutes les image locales et illustrations distantes[CR][Basique] Espace restreint sur les appareils limit\u00e9s ou en utilisant un habillage simple[CR][Personnalis\u00e9e] Configuration de l'utilisateur pour un contr\u00f4le en d\u00e9tail[CR][Aucune] Pas d'illustration", "id": "musiclibrary.artworklevel", "label": "Niveau d'illustration", "level": "standard", "options": [{"label": "Maximal", "value": 0}, {"label": "Base", "value": 1}, {"label": "Personnalisation", "value": 2}, {"label": "Aucun(e)", "value": 3}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": ["folder.jpg", "cover.jpg", "cover.jpeg", "thumb.jpg"], "definition": {"allowempty": true, "allownewoption": true, "control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": "folder.jpg, cover.jpg, cover.jpeg, thumb.jpg", "enabled": true, "help": "Les noms des fichiers qui contiennent l'illustration primaire (miniatures), g\u00e9n\u00e9ralement carr\u00e9e et utilis\u00e9e \u00e0 la fois en taille normale et r\u00e9duite pour identifier visuellement un dossier, un artiste, un album ou un titre", "id": "musiclibrary.musicthumbs.definition", "label": "Fichiers de miniatures d'images", "level": "expert", "options": [{"label": "folder.jpg", "value": "folder.jpg"}, {"label": "cover.jpg", "value": "cover.jpg"}, {"label": "cover.jpeg", "value": "cover.jpeg"}, {"label": "thumb.jpg", "value": "thumb.jpg"}], "parent": "", "type": "string", "value": "folder.jpg, cover.jpg, cover.jpeg, thumb.jpg"}, "delimiter": ", ", "elementtype": "string", "enabled": true, "help": "Les noms des fichiers qui contiennent l'illustration primaire (miniatures), g\u00e9n\u00e9ralement carr\u00e9e et utilis\u00e9e \u00e0 la fois en taille normale et r\u00e9duite pour identifier visuellement un dossier, un artiste, un album ou un titre", "id": "musiclibrary.musicthumbs", "label": "Fichiers de miniatures d'images", "level": "expert", "maximumItems": -1, "minimumItems": 0, "parent": "", "type": "list", "value": ["folder.jpg", "cover.jpg", "cover.jpeg", "thumb.jpg"]}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Lorsqu'il n'existe pas localement de couverture d'album, une illustration en ligne sera utilis\u00e9e. Si aucune n'est disponible, les images de couverture embarqu\u00e9es dans les fichiers musicaux seront utilis\u00e9es", "id": "musiclibrary.preferonlinealbumart", "label": "Pr\u00e9f\u00e9rer les illustrations d'album en ligne", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Va automatiquement \u00e0 la fen\u00eatre de visualisation quand la lecture audio d\u00e9bute", "id": "musicfiles.selectaction", "label": "Basculer en visualisation \u00e0 la lecture", "level": "basic", "parent": "", "type": "boolean", "value": false}, {"allowempty": false, "allownewoption": false, "control": {"delayed": true, "format": "string", "heading": "Options disponibles : %A, %T, %N, %B, %D, %G, %Y, %F, %S", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "[%N. ]%A - %T", "enabled": true, "help": "Contr\u00f4le la mani\u00e8re dont les noms de titres sont affich\u00e9s sur l'interface utilisateur. Afin de fonctionner correctement, les balises doivent \u00eatre activ\u00e9es.", "id": "musicfiles.trackformat", "label": "Mod\u00e8le de nom de piste", "level": "expert", "parent": "", "type": "string", "value": "[%N. ]%A - %T"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Recherche de miniatures sur les partages distants et les lecteurs optiques. Cela peut souvent ralentir le listage des dossiers r\u00e9seau.", "id": "musicfiles.findremotethumbs", "label": "Rechercher les miniatures sur les partages distants", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Lors du parcours de fichiers de musique en vue fichier, ceci lira les balises de celles ne figurant pas actuellement en m\u00e9diath\u00e8que. L'affichage de larges dossiers peut \u00eatre ralenti, en particulier sur un r\u00e9seau.", "id": "musicfiles.usetags", "label": "Activer la lecture de balises en vue fichier", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Si les informations EXIF existent (date, heure, appareil utilis\u00e9, etc.), elles seront affich\u00e9es.", "id": "pictures.usetags", "label": "Afficher les informations EXIF des images", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "G\u00e9n\u00e8re automatiquement les miniatures d'images lors de l'acc\u00e8s \u00e0 un dossier d'images.", "id": "pictures.generatethumbs", "label": "G\u00e9n\u00e9rer automatiquement les miniatures", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Affiche les vid\u00e9os dans la liste des fichiers image.", "id": "pictures.showvideos", "label": "Afficher les fichiers vid\u00e9o dans les listes", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": 0, "enabled": true, "help": "Active la lecture automatique du fichier suivant dans la liste pour les types de listes de lecture s\u00e9lectionn\u00e9s.", "id": "videoplayer.autoplaynextitem.definition", "label": "Lire la vid\u00e9o suivante automatiquement", "level": "basic", "options": [{"label": "Vid\u00e9os musicales", "value": 0}, {"label": "S\u00e9ries TV", "value": 1}, {"label": "\u00c9pisodes", "value": 2}, {"label": "Films", "value": 3}, {"label": "Sans cat\u00e9gorie", "value": 4}], "parent": "", "type": "integer", "value": 0}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "Active la lecture automatique du fichier suivant dans la liste pour les types de listes de lecture s\u00e9lectionn\u00e9s.", "id": "videoplayer.autoplaynextitem", "label": "Lire la vid\u00e9o suivante automatiquement", "level": "basic", "maximumItems": -1, "minimumItems": 0, "parent": "", "type": "list", "value": []}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [-600, -300, -180, -60, -30, -10, 10, 30, 60, 180, 300, 600], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": -600, "enabled": true, "help": "D\u00e9finit la taille des sauts \u00e0 utiliser en appuyant sur les touches de saut. Si plusieurs valeurs sont choisies pour une direction de saut, elles s'appliqueront lors d'appuis cons\u00e9cutifs de la touche de saut dans le d\u00e9lai de saut d\u00e9fini. Les sauts vers l'avant (positif) et en arri\u00e8re (n\u00e9gatif) peuvent \u00eatre d\u00e9finis ind\u00e9pendamment.", "id": "videoplayer.seeksteps.definition", "label": "\u00c9tapes des sauts", "level": "standard", "options": [{"label": "-30 min", "value": -1800}, {"label": "-10 min", "value": -600}, {"label": "-5 min", "value": -300}, {"label": "-3 min", "value": -180}, {"label": "-60 s", "value": -60}, {"label": "-30 s", "value": -30}, {"label": "-10 s", "value": -10}, {"label": "10 s", "value": 10}, {"label": "30 s", "value": 30}, {"label": "60 s", "value": 60}, {"label": "3 min", "value": 180}, {"label": "5 min", "value": 300}, {"label": "10 min", "value": 600}, {"label": "30 min", "value": 1800}], "parent": "", "type": "integer", "value": -600}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "D\u00e9finit la taille des sauts \u00e0 utiliser en appuyant sur les touches de saut. Si plusieurs valeurs sont choisies pour une direction de saut, elles s'appliqueront lors d'appuis cons\u00e9cutifs de la touche de saut dans le d\u00e9lai de saut d\u00e9fini. Les sauts vers l'avant (positif) et en arri\u00e8re (n\u00e9gatif) peuvent \u00eatre d\u00e9finis ind\u00e9pendamment.", "id": "videoplayer.seeksteps", "label": "\u00c9tapes des sauts", "level": "standard", "maximumItems": -1, "minimumItems": 2, "parent": "", "type": "list", "value": [-600, -300, -180, -60, -30, -10, 10, 30, 60, 180, 300, 600]}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ms", "minimumlabel": "Aucun(e)", "type": "spinner"}, "default": 750, "enabled": true, "help": "D\u00e9finit le temps d'attente entre deux appuis de touches cons\u00e9cutifs avant d'ex\u00e9cuter le saut. Ne s'applique qu'au saut intelligent (l'utilisation de plus d'un saut dans une m\u00eame direction).", "id": "videoplayer.seekdelay", "label": "D\u00e9lais des sauts", "level": "standard", "maximum": 3000, "minimum": 0, "parent": "", "step": 250, "type": "integer", "value": 750}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Autorise le changement du taux de rafra\u00eechissement de l'\u00e9cran pour correspondre au mieux \u00e0 celui de la vid\u00e9o. Cela peut rendre la lecture vid\u00e9o plus fluide.", "id": "videoplayer.adjustrefreshrate", "label": "Ajuster le taux de rafra\u00eechissement d'affichage", "level": "standard", "options": [{"label": "Non", "value": 0}, {"label": "Toujours", "value": 1}, {"label": "Au d\u00e9part / \u00e0 l'arr\u00eat", "value": 2}, {"label": "Au d\u00e9part", "value": 3}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Synchronise la vid\u00e9o et l'audio au taux de rafra\u00eechissement de l'\u00e9cran. Le lecteur VideoPlayer n'utilisera pas le mode laisser-passer (Passthrough) audio dans ce cas car cela n\u00e9cessiterait un r\u00e9\u00e9chantillonnage.", "id": "videoplayer.usedisplayasclock", "label": "Synchroniser la lecture avec l'affichage", "level": "standard", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} %", "minimumlabel": "Non", "type": "spinner"}, "default": 0, "enabled": true, "help": "\u00c9tire la vid\u00e9o jusqu'au pourcentage d\u00e9fini afin de minimiser les bandes noires.", "id": "videoplayer.errorinaspect", "label": "Minimiser les bandes noires", "level": "advanced", "maximum": 20, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "S\u00e9lection du niveau de zoom pour les vid\u00e9os 4:3 affich\u00e9es sur les \u00e9crans larges.", "id": "videoplayer.stretch43", "label": "Affichage des vid\u00e9os 4:3", "level": "advanced", "options": [{"label": "Normal", "value": 0}, {"label": "Zoom large", "value": 3}, {"label": "\u00c9tirement 16:9", "value": 4}, {"label": "\u00c9tirement 16:9 - Non lin\u00e9aire", "value": 7}, {"label": "Zoom", "value": 1}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Ajuste la m\u00e9thode utilis\u00e9e pour afficher et effectuer le rendu de la vid\u00e9o.", "id": "videoplayer.rendermethod", "label": "M\u00e9thode de rendu", "level": "advanced", "options": [{"label": "D\u00e9tection automatique", "value": 0}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} %", "type": "spinner"}, "default": 20, "enabled": true, "help": "Utilise des redimensionnements de haute qualit\u00e9 (HQ) avec ce % minimum lors de la mise \u00e0 l'\u00e9chelle d'une vid\u00e9o. Une valeur inf\u00e9rieure \u00e0 5\u00a0% n'a pas beaucoup d'int\u00e9r\u00eat car la vid\u00e9o sera trait\u00e9e avec une charge GPU importante sans augmentation visible de la qualit\u00e9 d'image.", "id": "videoplayer.hqscalers", "label": "Activer la mise \u00e0 l'\u00e9chelle HQ pour les agrandissements", "level": "advanced", "maximum": 100, "minimum": 0, "parent": "videoplayer.rendermethod", "step": 10, "type": "integer", "value": 20}, {"control": {"delayed": true, "format": "integer", "formatlabel": "{}", "type": "spinner"}, "default": 0, "enabled": true, "help": "S\u00e9lection du mode de lecture des vid\u00e9os 3D st\u00e9r\u00e9oscopiques.[CR][Demander] affichera une fen\u00eatre pour s\u00e9lectionner le mode d\u00e9sir\u00e9 pour chaque lecture.[CR][Mode pr\u00e9f\u00e9r\u00e9] utilisera le mode pr\u00e9f\u00e9r\u00e9 sp\u00e9cifi\u00e9 dans la section Syst\u00e8me -> Mat\u00e9riel des Param\u00e8tres.[CR][Monoscopique/2D] lira la vid\u00e9o en mono/2D.[CR][Ignorer] d\u00e9sactive toute gestion de la st\u00e9r\u00e9oscopie 3D.", "id": "videoplayer.stereoscopicplaybackmode", "label": "Mode de lecture pour les vid\u00e9os 3D st\u00e9r\u00e9oscopiques", "level": "advanced", "options": [{"label": "Me demander", "value": 0}, {"label": "Mode pr\u00e9f\u00e9r\u00e9", "value": 1}, {"label": "Monoscopique / 2D", "value": 2}, {"label": "Ignorer", "value": 100}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "[Activ\u00e9] R\u00e9tablit l'interface utilisateur (et certains TV) en mode 2D entre les vid\u00e9os d'une liste de lecture et en fin de lecture.[CR][D\u00e9sactiv\u00e9] Interface utilisateur et TV resteront en mode 3D st\u00e9r\u00e9oscopique. Pour les listes de lecture m\u00e9langeant des contenus 3D st\u00e9r\u00e9oscopiques et 2D, l'interface restera en 3D st\u00e9r\u00e9oscopique m\u00eame en cours de lecture 2D non st\u00e9r\u00e9oscopique.", "id": "videoplayer.quitstereomodeonstop", "label": "D\u00e9sactiver le mode 3D st\u00e9r\u00e9oscopique en fin de lecture", "level": "advanced", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Active le t\u00e9l\u00e9texte durant le visionnage d'une cha\u00eene TV en direct.", "id": "videoplayer.teletextenabled", "label": "Activer le t\u00e9l\u00e9texte", "level": "expert", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Adapte le t\u00e9l\u00e9texte en format 4:3.", "id": "videoplayer.teletextscale", "label": "Adapter le t\u00e9l\u00e9texte au 4:3", "level": "expert", "parent": "videoplayer.teletextenabled", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Lit automatiquement l'\u00e9l\u00e9ment suivant du dossier courant. Par exemple, dans la vue \u00ab Fichiers \u00bb apr\u00e8s la lecture d'une piste, la piste suivante dans le m\u00eame dossier sera lue automatiquement.", "id": "musicplayer.autoplaynextitem", "label": "Lire la chanson suivante automatiquement", "level": "basic", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Quand des titres sont s\u00e9lectionn\u00e9s, ils sont mis en attente au lieu d'\u00eatre jou\u00e9s imm\u00e9diatement.", "id": "musicplayer.queuebydefault", "label": "Placer en file d'attente les chansons s\u00e9lectionn\u00e9es", "level": "basic", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": [-60, -30, -10, 10, 30, 60], "definition": {"control": {"delayed": false, "format": "string", "multiselect": true, "type": "list"}, "default": -60, "enabled": true, "help": "D\u00e9finit la taille des sauts \u00e0 utiliser en appuyant sur les touches de saut. Si plusieurs valeurs sont choisies pour une direction de saut, elles s'appliqueront lors d'appuis cons\u00e9cutifs de la touche de saut dans le d\u00e9lai de saut d\u00e9fini. Les sauts vers l'avant (positif) et en arri\u00e8re (n\u00e9gatif) peuvent \u00eatre d\u00e9finis ind\u00e9pendamment.", "id": "musicplayer.seeksteps.definition", "label": "\u00c9tapes des sauts", "level": "standard", "options": [{"label": "-30 min", "value": -1800}, {"label": "-10 min", "value": -600}, {"label": "-5 min", "value": -300}, {"label": "-3 min", "value": -180}, {"label": "-60 s", "value": -60}, {"label": "-30 s", "value": -30}, {"label": "-10 s", "value": -10}, {"label": "10 s", "value": 10}, {"label": "30 s", "value": 30}, {"label": "60 s", "value": 60}, {"label": "3 min", "value": 180}, {"label": "5 min", "value": 300}, {"label": "10 min", "value": 600}, {"label": "30 min", "value": 1800}], "parent": "", "type": "integer", "value": -60}, "delimiter": ",", "elementtype": "integer", "enabled": true, "help": "D\u00e9finit la taille des sauts \u00e0 utiliser en appuyant sur les touches de saut. Si plusieurs valeurs sont choisies pour une direction de saut, elles s'appliqueront lors d'appuis cons\u00e9cutifs de la touche de saut dans le d\u00e9lai de saut d\u00e9fini. Les sauts vers l'avant (positif) et en arri\u00e8re (n\u00e9gatif) peuvent \u00eatre d\u00e9finis ind\u00e9pendamment.", "id": "musicplayer.seeksteps", "label": "\u00c9tapes des sauts", "level": "standard", "maximumItems": -1, "minimumItems": 2, "parent": "", "type": "list", "value": [-60, -30, -10, 10, 30, 60]}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} ms", "minimumlabel": "Aucun(e)", "type": "spinner"}, "default": 750, "enabled": true, "help": "D\u00e9finit le temps d'attente entre deux appuis de touches cons\u00e9cutifs avant d'ex\u00e9cuter le saut. Ne s'applique qu'au saut intelligent (l'utilisation de plus d'un saut dans une m\u00eame direction).", "id": "musicplayer.seekdelay", "label": "D\u00e9lais des sauts", "level": "standard", "maximum": 3000, "minimum": 0, "parent": "", "step": 250, "type": "integer", "value": 750}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} s", "minimumlabel": "Non", "type": "spinner"}, "default": 0, "enabled": true, "help": "Fondu entre deux pistes audio. Il est possible de r\u00e9gler le niveau de chevauchement de 1 \u00e0 15 secondes.", "id": "musicplayer.crossfade", "label": "Fondu-enchain\u00e9 entre les chansons", "level": "standard", "maximum": 15, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": false, "help": "Autorise le fondu quand deux pistes proviennent d'un m\u00eame album.", "id": "musicplayer.crossfadealbumtracks", "label": "Fondu-enchain\u00e9 des chansons d'un m\u00eame album", "level": "standard", "parent": "musicplayer.crossfade", "type": "boolean", "value": true}, {"addontype": "xbmc.player.musicviz", "allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "", "enabled": true, "help": "S\u00e9lectionne la visualisation qui sera affich\u00e9e durant l'\u00e9coute de musique.", "id": "musicplayer.visualisation", "label": "Visualisation", "level": "basic", "parent": "", "type": "addon", "value": ""}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 1, "enabled": true, "help": "Lit les informations ReplayGain encod\u00e9es dans les fichiers audio, par un programme comme MP3Gain, et normalise les niveaux sonores en cons\u00e9quence.", "id": "musicplayer.replaygaintype", "label": "R\u00e9glages du volume", "level": "expert", "options": [{"label": "Non", "value": 0}, {"label": "Utiliser les niveaux de piste", "value": 2}, {"label": "Utiliser les niveaux de l'album", "value": 1}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d}.0 dB", "type": "spinner"}, "default": 89, "enabled": true, "help": "Volume de r\u00e9f\u00e9rence (niveau de pr\u00e9ampli) \u00e0 utiliser pour les fichiers avec informations de gain de lecture. 89 dB est pr\u00e9d\u00e9fini conform\u00e9ment au standard. \u00c0 modifier avec pr\u00e9caution.", "id": "musicplayer.replaygainpreamp", "label": "Fichiers avec informations de gain (ReplayGain)", "level": "expert", "maximum": 101, "minimum": 77, "parent": "musicplayer.replaygaintype", "step": 1, "type": "integer", "value": 89}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d}.0 dB", "type": "spinner"}, "default": 89, "enabled": true, "help": "Volume de r\u00e9f\u00e9rence (niveau de pr\u00e9ampli) \u00e0 utiliser pour les fichiers sans informations de gain de lecture. 89dB est pr\u00e9d\u00e9fini conform\u00e9ment au standard. \u00c0 modifier avec pr\u00e9caution.", "id": "musicplayer.replaygainnogainpreamp", "label": "Fichiers sans informations de gain (ReplayGain)", "level": "expert", "maximum": 101, "minimum": 77, "parent": "musicplayer.replaygaintype", "step": 1, "type": "integer", "value": 89}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Joue le fichier \u00e0 volume plus faible, si n\u00e9cessaire, pour \u00e9viter que le son limite la protection d'\u00e9cr\u00eatage. Sinon cette protection sera fournie par le moteur audio dans les parties le n\u00e9cessitant.", "id": "musicplayer.replaygainavoidclipping", "label": "\u00c9viter la protection d'\u00e9cr\u00eatage avec les fichiers ReplayGain", "level": "expert", "parent": "musicplayer.replaygaintype", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Lit automatiquement le disque apr\u00e8s insertion dans le lecteur.", "id": "dvds.autorun", "label": "Lire les disques automatiquement", "level": "basic", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{}", "minimumlabel": "Non", "type": "spinner"}, "default": 0, "enabled": true, "help": "Force une r\u00e9gion pour la lecture d'un disque optique.", "id": "dvds.playerregion", "label": "Forcer la r\u00e9gion du lecteur", "level": "standard", "maximum": 8, "minimum": 0, "parent": "", "step": 1, "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": false, "enabled": true, "help": "Tente de passer outre les avertissements l\u00e9gaux avant le menu du disque.", "id": "dvds.automenu", "label": "Tenter d'ignorer l'introduction avant le menu", "level": "advanced", "parent": "", "type": "boolean", "value": false}, {"control": {"delayed": false, "format": "string", "formatlabel": "{}", "type": "spinner"}, "default": 1, "enabled": true, "help": "R\u00e9gion A - Am\u00e9riques, Asie de l'Est et Asie du Sud-Est. R\u00e9gion B - Afrique, Moyen Orient, Asie du Sud-ouest, Europe, Australie et Nouvelle-Z\u00e9lande. R\u00e9gion C - Asie Centrale, Chine m\u00e9tropolitaine, Mongolie, Asie du Sud, Bi\u00e9lorussie, Russie, Ukraine et Kazakhstan.", "id": "bluray.playerregion", "label": "Code r\u00e9gion Blu-ray", "level": "standard", "options": [{"label": "R\u00e9gion A", "value": 1}, {"label": "R\u00e9gion B", "value": 2}, {"label": "R\u00e9gion C", "value": 4}], "parent": "", "type": "integer", "value": 1}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Sp\u00e9cifie comment les Blu-rays doivent \u00eatre ouverts/lus.[CR]NB : certains menus de disque ne sont pas enti\u00e8rement pris en charge et peuvent provoquer des probl\u00e8mes.", "id": "disc.playback", "label": "Mode de lecture Blu-ray", "level": "standard", "options": [{"label": "Afficher les menus simplifi\u00e9s", "value": 0}, {"label": "Afficher le menu Blu-ray", "value": 1}, {"label": "Lire le film", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "string", "multiselect": false, "type": "list"}, "default": 0, "enabled": true, "help": "Lecture automatique des CD apr\u00e8s insertion dans le lecteur.", "id": "audiocds.autoaction", "label": "Action \u00e0 l'insertion d'un CD Audio", "level": "standard", "options": [{"label": "Aucun(e)", "value": 0}, {"label": "Lire", "value": 1}, {"label": "Extraire", "value": 2}], "parent": "", "type": "integer", "value": 0}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Retrouve les informations d'un CD Audio, comme le titre et l'artiste, depuis la base de donn\u00e9es Internet gnudb.org.", "id": "audiocds.usecddb", "label": "R\u00e9cup\u00e9rer les informations des CD depuis un service en ligne", "level": "standard", "parent": "", "type": "boolean", "value": true}, {"allowempty": true, "allownewoption": false, "control": {"delayed": false, "format": "path", "heading": "Rechercher un dossier", "type": "button"}, "default": "", "enabled": true, "help": "S\u00e9lectionne l'emplacement du dispositif de stockage o\u00f9 seront enregistr\u00e9es les pistes copi\u00e9es.", "id": "audiocds.recordingpath", "label": "Dossier des enregistrements musicaux", "level": "expert", "parent": "", "sources": [], "type": "path", "value": "", "writable": true}, {"allowempty": false, "allownewoption": false, "control": {"delayed": true, "format": "string", "heading": "Options disponibles : %A, %T, %N, %B, %D, %G, %Y, %F, %S", "hidden": false, "type": "edit", "verifynewvalue": false}, "default": "%A/%A - %B/[%N. ][%A - ]%T", "enabled": true, "help": "Contr\u00f4le comment la musique enregistr\u00e9e est nomm\u00e9e \u00e0 partir des balises suivantes. [B]%N[/B] : num\u00e9ro de la piste, [B]%S[/B] : num\u00e9ro du disque, [B]%A[/B] : artiste, [B]%T[/B] : titre, [B]%B[/B] : album, [B]%G[/B] : genre, [B]%Y[/B] : ann\u00e9e, [B]%F[/B] : nom du fichier, [B]%D[/B] : dur\u00e9e, [B]%J[/B] : date, [B]%R[/B] : notation, [B]%I[/B] : taille du fichier.", "id": "audiocds.trackpathformat", "label": "Mod\u00e8le de nom de piste", "level": "expert", "parent": "", "type": "string", "value": "%A/%A - %B/[%N. ][%A - ]%T"}, {"addontype": "kodi.audioencoder", "allowempty": false, "allownewoption": false, "control": {"delayed": false, "format": "addon", "type": "button"}, "default": "audioencoder.kodi.builtin.aac", "enabled": true, "help": "S\u00e9lectionne l'encodeur audio utilis\u00e9 pour l'encodage.", "id": "audiocds.encoder", "label": "Encodeur", "level": "expert", "parent": "", "type": "addon", "value": "audioencoder.kodi.builtin.aac"}, {"control": {"delayed": false, "format": "action", "type": "button"}, "data": "", "enabled": true, "help": "Configure les param\u00e8tres d'encodage audio tels que la qualit\u00e9 et le niveau de compression", "id": "audiocds.settings", "label": "Param\u00e8tres", "level": "expert", "parent": "audiocds.encoder", "type": "action"}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "\u00c9jecte automatiquement le CD \u00e0 la fin de l'extraction.", "id": "audiocds.ejectonrip", "label": "\u00c9jecter le CD \u00e0 la fin de l'extraction", "level": "expert", "parent": "", "type": "boolean", "value": true}, {"control": {"delayed": false, "format": "string", "formatlabel": "{0:d} s", "type": "spinner"}, "default": 5, "enabled": true, "help": "S\u00e9lectionne la dur\u00e9e pendant laquelle chaque image est affich\u00e9e lors d'un diaporama.", "id": "slideshow.staytime", "label": "Dur\u00e9e d'affichage de chaque image", "level": "basic", "maximum": 100, "minimum": 1, "parent": "", "step": 1, "type": "integer", "value": 5}, {"control": {"delayed": false, "format": "boolean", "type": "toggle"}, "default": true, "enabled": true, "help": "Applique des effets panoramique et de zoom sur les images pendant le diaporama.", "id": "slideshow.displayeffects", "label": "Utiliser les effets panoramique et zoom", "level": "standard", "parent": "", "type": "boolean", "val